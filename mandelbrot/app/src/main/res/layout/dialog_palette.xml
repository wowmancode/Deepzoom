<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp">

        <View
            android:id="@+id/c_preview"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/c_preset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/c_preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="8"
            android:stepSize="1"
            android:value="0"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/c_cycle_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/c_cycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="2"
            android:valueTo="13"
            android:stepSize="0.25"
            android:value="6"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/c_offset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/c_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="1"
            android:stepSize="0.01"
            android:value="0"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="Custom colours — hex values, comma separated"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/c_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:textSize="12sp"
            android:hint="#001428, #0a6ba8, #ffe9b0"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Interior colour"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/c_interior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="12sp"
            android:hint="#000000"
            android:importantForAutofill="no" />
    </LinearLayout>
</ScrollView>
