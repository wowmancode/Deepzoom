<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/p_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:paddingBottom="10dp" />

    <ProgressBar
        android:id="@+id/p_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <!-- Strip detail, below the frame line so the frame is never hidden by it. -->
    <TextView
        android:id="@+id/p_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:alpha="0.7"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/p_subbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone" />
    <!-- Pause lives in the layout rather than as a dialog button, because a dialog
         button dismisses the dialog and this one must leave it standing. Hidden
         unless the caller shows it, so the image export dialog is unchanged. -->
    <Button
        android:id="@+id/p_pause"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Pause"
        android:textColor="#7FA6D8"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
